<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Teams Pulse</string>
	<key>CFBundleExecutable</key>
	<string>TeamsPulse</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<!-- Full Disk Access and the keychain key are tied to this identifier and the signing
	     certificate (see scripts/make-signing-identity.sh). Changing either loses both. -->
	<key>CFBundleIdentifier</key>
	<string>com.asaf.TeamsPulse</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Teams Pulse</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- The build sets CFBundleVersion to this version too: Sparkle compares it to find updates. -->
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>LSMinimumSystemVersion</key>
	<string>15.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Asaf Manassen. Licensed under GPL-3.0-or-later.</string>
	<!-- Sparkle: the appcast is an asset of the latest GitHub release. -->
	<key>SUFeedURL</key>
	<string>https://github.com/mnsn/teams-pulse/releases/latest/download/appcast.xml</string>
	<!-- Updates, the appcast and its release notes must be signed with this key's private key.
	     scripts/make-release-keys.sh sets it once. Never change it afterwards: installed apps would
	     reject every update (see CONTRIBUTING.md). While it's empty, the app doesn't check for updates. -->
	<key>SUPublicEDKey</key>
	<string></string>
	<key>SURequireSignedFeed</key>
	<true/>
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
	<!-- Never fall back to accepting an unsigned appcast. The fallback is for rotating keys with a
	     Developer ID signature, which this app doesn't have. -->
	<key>SUSignedFeedFailureExpirationInterval</key>
	<integer>0</integer>
</dict>
</plist>
