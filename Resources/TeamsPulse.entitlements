<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app is signed with the hardened runtime, so no other process can inject code into it
	     (DYLD_* variables are ignored) and use its Full Disk Access. Library validation, though, only
	     loads frameworks with the app's Team ID, and a self-signed certificate has none, so it refuses
	     Sparkle.framework, the updater, even signed with the same certificate. This turns off only
	     that check. scripts/check-app.sh fails on any other entitlement. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
